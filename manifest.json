{
  "manifest_version": 3,
  "name": "Botó inscripció GTAF",
  "version": "1.6.0",
  "description": "Genera el botó d'inscripció d'una activitat de GTAF.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Botó inscripció GTAF",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "clipboardWrite", "activeTab", "scripting"],
  "host_permissions": [
    "https://aplicacions.gestioeducativa.gencat.cat/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://aplicacions.gestioeducativa.gencat.cat/ords/pls/soloas/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}